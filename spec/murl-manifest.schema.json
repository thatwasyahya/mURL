{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/thatwasyahya/mURL/main/spec/murl-manifest.schema.json",
  "title": "mURL manifest",
  "$comment": "DESCRIPTIVE tooling aid for the mURL manifest format v0.2 (spec/SPECIFICATION.md is normative, and the reference validator in crates/murl-core enforces rules JSON Schema cannot express: duplicate-member rejection, dependsOn referential integrity and acyclicity, per-kind target validation beyond shape, notBefore strictly before expires, integer-only numbers inside free-form meta, and resolution-time checks such as identity binding).",
  "type": "object",
  "required": ["murlVersion", "name", "resources"],
  "properties": {
    "murlVersion": {
      "enum": ["0.1", "0.2"],
      "$comment": "Writers emit 0.2; 0.1 remains accepted (spec §9)."
    },
    "id": {
      "type": "string",
      "pattern": "^murl://",
      "maxLength": 1024,
      "$comment": "Must be a canonical mURL without selector or query; full grammar is spec §3."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,5}(\\.[0-9]{1,5}){0,2}$"
    },
    "notBefore": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/resource" }
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/relation" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "additionalProperties": true,
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "resource": {
      "type": "object",
      "required": ["id", "kind", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/resourceId" },
        "kind": {
          "type": "string",
          "pattern": "^(https|file|dir|murl|terminal|ssh|remote-desktop|geo|mailto|custom:[a-z0-9][a-z0-9_-]{0,31})$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "required": { "type": "boolean" },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/resourceId" }
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          }
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[A-Za-z0-9+/=]{44}$"
        },
        "meta": {
          "$comment": "Opaque to the resolver. Numbers anywhere must still be integers (not expressible here)."
        }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["from", "rel", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/resourceId" },
        "rel": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{0,31}$"
        },
        "to": { "$ref": "#/$defs/resourceId" }
      },
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "publicKey", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{16}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "additionalProperties": true
    }
  }
}
