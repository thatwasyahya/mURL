{
  "murlVersion": "0.2",
  "name": "Local resources",
  "resources": [
    {
      "id": "home",
      "kind": "dir",
      "target": "~/projects/demo"
    },
    {
      "id": "abs",
      "kind": "file",
      "target": "/etc/hostname"
    },
    {
      "id": "win",
